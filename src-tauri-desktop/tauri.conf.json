{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chottu",
  "version": "0.1.0",
  "identifier": "ai.tinyhumans.chottu",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../src-native/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Chottu",
        "width": 1024,
        "height": 720,
        "label": "main",
        "minWidth": 480,
        "minHeight": 360,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' data: blob:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "chottu"
        ]
      }
    }
  },
  "mainBinaryName": "chottu"
}
