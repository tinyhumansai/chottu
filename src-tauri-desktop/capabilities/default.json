{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main desktop window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "log:default",
    "store:default",
    "notification:default",
    "dialog:default",
    "fs:default",
    "os:default",
    "clipboard-manager:default",
    "process:default",
    "deep-link:default",
    "window-state:default",
    "global-shortcut:default",
    "autostart:default"
  ],
  "platforms": [
    "macOS",
    "windows",
    "linux"
  ]
}
