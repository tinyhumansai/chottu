{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp"
  },
  "include": ["vite.config.ts"]
}
